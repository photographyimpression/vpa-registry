# =============================================================================
# docker-mailserver environment configuration
# Full reference: https://docker-mailserver.github.io/docker-mailserver/latest/config/environment/
# =============================================================================

# --- General ---
OVERRIDE_HOSTNAME=mail.vparegistry.com
LOG_LEVEL=warn
POSTMASTER_ADDRESS=hello@vparegistry.com

# --- TLS (SSL) ---
# Use Let's Encrypt certificates (run certbot on the host first)
# certbot certonly --standalone -d mail.vparegistry.com
SSL_TYPE=letsencrypt

# --- SMTP ---
SMTP_ONLY=0
ENABLE_SMTP_AUTH=1

# --- Security ---
SPOOF_PROTECTION=1
ENABLE_SRS=1
ENABLE_FAIL2BAN=1

# --- DKIM ---
ENABLE_OPENDKIM=1
# DKIM key size (generated by script 04-generate-dkim.sh)

# --- Spam / Filtering ---
ENABLE_SPAMASSASSIN=0
ENABLE_CLAMAV=0
ENABLE_AMAVIS=0
# Disabled for warming mailboxes — no need for spam filtering on outbound-only accounts

# --- IMAP ---
ENABLE_DOVECOT=1

# --- Postfix ---
POSTFIX_MESSAGE_SIZE_LIMIT=26214400
