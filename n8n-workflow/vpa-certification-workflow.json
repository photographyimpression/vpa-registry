                    "value": {
                        "VPA_Tracking_ID": "={{ $('\ud83d\udce6 Prepare Upload').item.json.vpaId }}",
                        "Cert_Issue_Date": "={{ $('\ud83d\udce6 Prepare Upload').item.json.issueDate }}",
                        "Manufacturer_Name": "={{ $('\ud83d\udce6 Prepare Upload').item.json.manufacturerName }}",
                        "Device_Metadata": "={{ $('\ud83d\udce6 Prepare Upload').item.json.deviceMetadata }}",
                        "Master_Image_URL": "={{ $json.webViewLink || $('\ud83d\udce6 Prepare Upload').item.json.registryUrl }}",
                        "Product_Name": "={{ $('\ud83d\udce6 Prepare Upload').item.json.productName }}",
                        "Certified_Image_URL": "={{ $json.webViewLink || '' }}"
                    }
                },
                "options": {},
                "authentication": "serviceAccount"
            },
            "id": "node-sheets",
            "name": "\ud83d\udcca Write to Google Sheets",
            "type": "n8n-nodes-base.googleSheets",
            "typeVersion": 4,
            "position": [
                2880,
