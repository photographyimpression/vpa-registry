                "responseBody": "={{ JSON.stringify({ vpaId: $('\ud83d\udce6 Prepare Upload').item.json.vpaId, certifiedImageUrl: $('\ud83d\udd17 Get Public Image URL').item.json.webViewLink || '', certifiedImageBase64: $('\ud83d\udce6 Prepare Upload').item.json.certifiedImageBase64, registryUrl: $('\ud83d\udce6 Prepare Upload').item.json.registryUrl, issueDate: $('\ud83d\udce6 Prepare Upload').item.json.issueDate, productName: $('\ud83d\udce6 Prepare Upload').item.json.productName, success: true }) }}"
            },
